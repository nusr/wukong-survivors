{
  "name": "wukong-survivors",
  "version": "1.0.0",
  "description": "Wukong Survivors game built with Phaser.js + Vite + React",
  "keywords": [
    "game",
    "phaser",
    "survivors",
    "vite"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "start": "vite --host",
    "build": "vite build",
    "type-check": "tsc",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:production": "TEST_ENV=production npx playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@sentry/react": "^11.17.0",
    "i18next": "^27.2.6",
    "lodash": "^4.18.1",
    "phaser": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@codecov/vite-plugin": "^2.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "canvas": "^3.2.3",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "yarn@1.22.22"
}
